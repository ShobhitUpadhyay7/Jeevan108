{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES6",
    "module": "commonjs",
    "lib": ["ES6"],
    "esModuleInterop": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,

    /* Project Structure */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Node compatibility */
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"],
  "exclude": ["node_modules","dist"]
}